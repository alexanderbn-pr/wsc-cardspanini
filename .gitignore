# IDE
# .vscode se comparte en parte: settings.json define el formateo al guardar y
# debe llegar a todo el equipo. El resto (launch.json, caches) sigue ignorado.
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Test
coverage/
.nyc_output/

# Docker
docker/data/

# SDD
.atl/
.vercel

# Entorno. .env* es amplio a propósito: cubre .env, .env.local, .env.production
# y cualquier variante. La única excepción es la plantilla, que debe poder
# subirse porque no contiene valores reales.
.env*
!.env.example
