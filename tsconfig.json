{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "helmet": ["./node_modules/helmet/index.d.mts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "api/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
