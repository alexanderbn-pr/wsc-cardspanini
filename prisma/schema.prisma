model Team {
  id       Int       @id @default(autoincrement())
  name     String
  stickers Sticker[]

  @@map("Teams")
}
// "prisma:merge": "prisma-merge-schema -d prisma/models/base.prisma -d prisma/models/teams.prisma -d prisma/models/user.prisma -d prisma/models/stickers.prisma -o prisma/schema.prisma",
// npm run prisma:merge --> instruccion para fusionar los archivos .prisma en un schema.primsa para cuando tengamos muchas tablas

model User {
  id       Int       @id @default(autoincrement())
  email     String
  passwordHash String
  role String
}
model Sticker {
  id         Int      @id @default(autoincrement())
  name       String
  number     String
  positionId Int
  position   Position @relation(fields: [positionId], references: [id])
  check      Boolean  @default(false)
  quantity   Int      @default(0)
  idTeam     Int
  team       Team     @relation(fields: [idTeam], references: [id])

  @@map("Stickers")
}
model Position {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  stickers Sticker[]

  @@map("Position")
}
