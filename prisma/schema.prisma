model User {
  id       Int       @id @default(autoincrement())
  email     String
  passwordHash String
  role String
}
model Sticker {
  id         Int      @id @default(autoincrement())
  name       String
  number     String
  positionId Int
  position   Position @relation(fields: [positionId], references: [id])
  check      Boolean  @default(false)
  quantity   Int      @default(0)
  idTeam     Int
  team       Team     @relation(fields: [idTeam], references: [id])

  @@map("Stickers")
}
model Position {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  stickers Sticker[]

  @@map("Position")
}
