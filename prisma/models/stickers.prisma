model Sticker {
  id         Int      @id @default(autoincrement())
  name       String
  number     String
  positionId Int
  position   Position @relation(fields: [positionId], references: [id])
  check      Boolean  @default(false)
  quantity   Int      @default(0)
  idTeam     Int
  team       Team     @relation(fields: [idTeam], references: [id])
  // int8 en la DB real (int4 → BigInt es la excepción documentada en base.prisma).
  editionId  BigInt?  @db.BigInt
  edition    Edition? @relation(fields: [editionId], references: [id])

  @@map("Stickers")
}
